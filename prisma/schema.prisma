generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  passwordHash     String?
  image            String?
  gender           String?
  age              Int?
  heightCm         Float?
  weightKg         Float?
  goal             String?
  activityLevel    String?
  dailyCalorieGoal Int           @default(2200)
  dailyProteinGoal Int           @default(130)
  dailyCarbsGoal   Int           @default(250)
  dailyFatsGoal    Int           @default(70)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  workoutLogs      WorkoutLog[]
  foodLogs         FoodLog[]
  chatMessages     ChatMessage[]
  goals            UserGoal[]

  @@index([createdAt])
}

model Exercise {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  category         String
  muscleGroup      String
  secondaryMuscles String[]
  equipment        String
  difficulty       String
  imageUrl         String
  instructions     String
  tips             String
  createdAt        DateTime     @default(now())
  workoutLogs      WorkoutLog[]

  @@index([createdAt])
}

model WorkoutLog {
  id              String   @id @default(cuid())
  userId          String
  exerciseId      String
  sets            Int
  reps            Int
  weightKg        Float    @default(0)
  durationMinutes Float?
  restSeconds     Int?
  notes           String?
  performedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise        Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
  @@index([performedAt])
  @@index([createdAt])
}

model FoodItem {
  id          String   @id @default(cuid())
  name        String
  servingSize String
  calories    Float    @default(0)
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatsG       Float    @default(0)
  fiberG      Float?
  sugarG      Float?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model FoodLog {
  id          String   @id @default(cuid())
  userId      String
  foodName    String
  quantity    Float    @default(1)
  servingUnit String
  calories    Float    @default(0)
  proteinG    Float    @default(0)
  carbsG      Float    @default(0)
  fatsG       Float    @default(0)
  mealType    String
  consumedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([consumedAt])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model UserGoal {
  id           String    @id @default(cuid())
  userId       String
  goalType     String
  targetValue  Float
  currentValue Float?
  unit         String
  deadline     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}
